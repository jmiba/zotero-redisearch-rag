{
  "name": "zotero-redisearch-rag",
  "version": "1.0.10",
  "description": "Obsidian plugin for Zotero -> Docling -> Redis Search RAG",
  "main": "main.js",
  "scripts": {
    "test:typescript": "node scripts/run-typescript-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config eslint.config.mjs src/**/*.ts",
    "lint:changed": "node scripts/lint-changed.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "build": "node scripts/build-tool-assets.mjs && node esbuild.config.mjs production",
    "dev": "node scripts/build-tool-assets.mjs && node esbuild.config.mjs",
    "build:release": "npm run lint && npm run typecheck && npm run test:typescript && npm run validate:manifest && npm run build",
    "package-release": "bash scripts/package-release.sh"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.14.9",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.35.1"
  }
}
